# TradingAgents sidecar service configuration.
# Copy to .env and fill in. Only AI_GATEWAY_API_KEY is required for real runs.

# --- LLM credentials (shared with Chloei) -----------------------------------
# Reuse the same Vercel AI Gateway key the Chloei web app uses. It is seeded
# into the active provider's key variable (OPENROUTER_API_KEY by default) at
# startup, so you only set it once here.
AI_GATEWAY_API_KEY=

# --- LLM routing (defaults target Vercel AI Gateway) ------------------------
# The "openrouter" provider is an OpenAI-compatible Chat Completions client
# that honours a custom base_url — the right adapter for the gateway. Avoid
# "openai" here: it forces the Responses API, which the gateway does not expose.
TRADINGAGENTS_LLM_PROVIDER=openrouter
TRADINGAGENTS_LLM_BACKEND_URL=https://ai-gateway.vercel.sh/v1
# Use AI Gateway model slugs (vendor/model). Deep = heavier reasoning agents
# (Research Manager, Trader, Portfolio Manager); Quick = analysts/utility.
# NOTE: some models (e.g. alibaba/qwen3.7-max in thinking mode) reject the
# tool_choice=required/object that TradingAgents' structured-output agents send
# and fail with HTTP 400. The OpenAI gpt-5.x family works natively, so it is the
# safe production default. Swap in any tool-calling model you prefer.
TRADINGAGENTS_DEEP_THINK_LLM=openai/gpt-5.5
TRADINGAGENTS_QUICK_THINK_LLM=openai/gpt-5.4-mini

# --- Service security / wiring ----------------------------------------------
# Shared secret required in the X-Service-Token header. Set the same value as
# TRADINGAGENTS_SERVICE_TOKEN in the Chloei app so only it can call /analyze.
# Leave blank to disable the check (local dev only).
TRADINGAGENTS_SERVICE_TOKEN=
# Comma-separated browser origins allowed by CORS (only needed if a browser
# calls the service directly; Chloei proxies server-side so this is optional).
TRADINGAGENTS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Mock mode --------------------------------------------------------------
# 1 = always stream a canned, no-LLM analysis (great for frontend dev / CI).
# Individual requests can also force it with {"mock": true}.
TRADINGAGENTS_MOCK=0

# --- Cross-run memory / reflection loop -------------------------------------
# TradingAgents' native learning loop: each run resolves the realized outcome
# of prior same-ticker calls, reflects on them via the LLM, and feeds those
# lessons into the next run's prompts. 1 = enabled (default), 0 = fully
# stateless (nulls the log path so every memory op no-ops).
TRADINGAGENTS_MEMORY_ENABLED=1
# Where the append-only reflection log lives. Point this at a persistent,
# writable location (a mounted volume in Docker) so learning survives restarts.
# Defaults to ~/.tradingagents/memory/trading_memory.md when unset.
# TRADINGAGENTS_MEMORY_LOG_PATH=/data/memory/trading_memory.md

# --- Optional market data keys ----------------------------------------------
# yfinance (the default vendor) needs no key. Set these only if you switch
# vendors or want broader coverage.
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
