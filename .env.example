# Required for local development.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for chat/model streaming. Mock smoke tests can run without it.
# Get your key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# --- Optional: enable extra features (safe defaults apply when unset) ---

# Separate Better Auth database URL (falls back to DATABASE_URL).
# AUTH_DATABASE_URL=

# Enable Tavily search + extract tools. https://app.tavily.com
# TAVILY_API_KEY=

# Vercel Edge Config connection for remote feature flags.
# EDGE_CONFIG=

# Feature flags (default off; may also be synced via Edge Config).
# AGENT_TELEMETRY_RECORD_IO=false

# --- Optional Better Auth origins/cookies (see CLAUDE.md for Vercel guidance) ---
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BETTER_AUTH_COOKIE_DOMAIN=chloei.ai

# Notes
# - Agent request limits, timeouts, tool-step budgets, and rate-limit windows are
#   fixed safe constants in src/lib/server/agent-runtime-config.ts (no env knobs).
# - A few advanced switches remain env-readable but are intentionally omitted here:
#   AGENT_RATE_LIMIT_ENABLED, AGENT_RATE_LIMIT_STORE.
# - `vercel env pull .env.local` is the quickest way to hydrate local development.
