# Required for local development.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for chat/model streaming. Mock smoke tests can run without it.
# Get your key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# --- Optional: enable extra features (safe defaults apply when unset) ---

# Separate Better Auth database URL (falls back to DATABASE_URL).
# AUTH_DATABASE_URL=

# Enable Tavily search + extract tools. https://app.tavily.com
# TAVILY_API_KEY=

# Descriptive user agent for SEC public filing/company-facts calls.
# SEC_API_USER_AGENT=Chloei finance research your-email@example.com

# Private Vercel Blob store for attachment uploads + agent artifacts.
# Create with `vercel blob create-store chloei-private --access private`, then `vercel env pull .env.local`.
# BLOB_READ_WRITE_TOKEN=

# Durable async jobs through Inngest (Trading Desk background runs).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_ENV=
# INNGEST_DEV=
# Run jobs inline without Inngest (1/true).
# INNGEST_INLINE_FALLBACK=

# Vercel Edge Config connection for remote feature flags.
# EDGE_CONFIG=

# Feature flags (default off; may also be synced via Edge Config).
# AGENT_FINANCE_WORKFLOWS_ENABLED=false
# AGENT_TELEMETRY_RECORD_IO=false
# AGENT_INTERNAL_USER_EMAILS=
# AGENT_INTERNAL_USER_EMAIL_DOMAINS=
# AGENT_ENABLE_NEW_CAPABILITIES_FOR_INTERNAL_USERS=false

# Trading Desk (TradingAgents multi-agent sidecar). See tradingagents-service/README.md.
# TRADINGAGENTS_SERVICE_URL=http://localhost:8000
# TRADINGAGENTS_SERVICE_TOKEN=
# TRADINGAGENTS_ENABLED=true

# --- Optional Better Auth origins/cookies (see CLAUDE.md for Vercel guidance) ---
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BETTER_AUTH_COOKIE_DOMAIN=chloei.ai

# Notes
# - Agent request limits, timeouts, tool-step budgets, and rate-limit windows are
#   fixed safe constants in src/lib/server/agent-runtime-config.ts (no env knobs).
# - A few advanced switches remain env-readable but are intentionally omitted here:
#   AGENT_RATE_LIMIT_ENABLED, AGENT_RATE_LIMIT_STORE, AGENT_CODE_EXECUTION_BACKEND.
# - `vercel env pull .env.local` is the quickest way to hydrate local development.
