# Required for local development.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for chat/model streaming. Mock smoke tests can run without it.
# Get your key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# --- Optional: enable extra features (safe defaults apply when unset) ---

# Separate Better Auth database URL (falls back to DATABASE_URL).
# AUTH_DATABASE_URL=

# Enable Tavily search + extract tools. https://app.tavily.com
# TAVILY_API_KEY=

# Vercel Edge Config connection for remote feature flags.
# EDGE_CONFIG=

# Feature flags (default off; may also be synced via Edge Config).
# AGENT_TELEMETRY_RECORD_IO=false

# --- Optional Better Auth origins/cookies (see CLAUDE.md for Vercel guidance) ---
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BETTER_AUTH_COOKIE_DOMAIN=chloei.ai

# --- Testing / CI only (not needed for local development) ---
# Mocked Playwright smoke test (pnpm test:smoke:mock):
#   E2E_MOCK_AUTH, E2E_MOCK_AUTH_ALLOW_NEXT_START, E2E_MOCK_AGENT_RESPONSE,
#   E2E_MOCK_FOLLOW_UP_QUESTIONS
# Live/opt-in smoke test (pnpm test:smoke):
#   SMOKE_BASE_URL, SMOKE_EMAIL, SMOKE_PASSWORD, SMOKE_PROMPT,
#   SMOKE_EXPECTED_TEXT, SMOKE_PORT

# --- Set automatically by the platform; do NOT set these locally ---
# NODE_ENV, CI, and the VERCEL_* vars (VERCEL_ENV, VERCEL_TARGET_ENV,
# VERCEL_REGION, VERCEL_DEPLOYMENT_ID, VERCEL_PROJECT_ID, VERCEL_GIT_COMMIT_SHA).

# Notes
# - Agent request limits, timeouts, and tool-step budgets are fixed safe
#   constants in src/lib/server/agent-runtime-config.ts (no env knobs).
# - `vercel env pull .env.local` is the quickest way to hydrate local development.
