# Required for local development.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for chat/model streaming. Mock smoke tests can run without it.
# Get your key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: separate Better Auth database URL.
# Falls back to DATABASE_URL when unset.
# AUTH_DATABASE_URL=

# Optional: enable Tavily search + extract tools alongside AI Gateway native search tools
# Get your key at https://app.tavily.com
# TAVILY_API_KEY=

# Optional: governed internal knowledge retrieval through the Vercel Upstash Search integration.
# Use for static/internal policies, notes, transcripts, uploaded-document text chunks, and reference material.
# Do not use this for live market prices, filings, news, or macro releases.
# UPSTASH_SEARCH_REST_URL=
# UPSTASH_SEARCH_REST_TOKEN=
# UPSTASH_SEARCH_INDEX=chloei-knowledge
# UPSTASH_DISABLE_TELEMETRY=1

# Optional: durable agent workflows through Inngest.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_ENV=
# INNGEST_DEV=

# Optional: private Vercel Blob store token for uploads and agent artifacts.
# Create with `vercel blob create-store chloei-private --access private`, then `vercel env pull .env.local`.
# BLOB_READ_WRITE_TOKEN=

# Optional: feature flags. Defaults are privacy-first/off outside explicitly configured internal users.
# These may also be synced from PostHog-backed Vercel Flags into Edge Config using the same dotted keys.
# AGENT_KNOWLEDGE_SEARCH_ENABLED=false
# AGENT_ASYNC_REPORTS_ENABLED=false
# AGENT_TELEMETRY_RECORD_IO=false
# AGENT_FINANCE_WORKFLOWS_ENABLED=false
# AGENT_INTERNAL_USER_EMAILS=
# AGENT_INTERNAL_USER_EMAIL_DOMAINS=
# AGENT_ENABLE_NEW_CAPABILITIES_FOR_INTERNAL_USERS=false

# Optional: privacy-safe PostHog product analytics. Defaults off.
# The Vercel PostHog integration injects NEXT_PUBLIC_POSTHOG_HOST and NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN.
# When enabled, Chloei captures only coarse server-side product events with hashed user ids, no GeoIP,
# no PostHog person profiles, no prompt/output/attachment content, and no browser autocapture or replay.
# Server-side PostHog capture is restricted to AGENT_INTERNAL_USER_EMAILS/DOMAINS unless explicitly disabled.
# POSTHOG_ANALYTICS_ENABLED=false
# POSTHOG_ANALYTICS_INTERNAL_USERS_ONLY=true
# NEXT_PUBLIC_POSTHOG_ANALYTICS_ENABLED=false
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=

# Optional: OpenTelemetry/Sentry observability.
# AI SDK telemetry records metadata only unless AGENT_TELEMETRY_RECORD_IO=true.
# OTEL_SERVICE_NAME=chloei
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Optional: enable curated FMP MCP finance tools alongside AI Gateway chat tools
# Uses a single server-global Financial Modeling Prep API key
# Get your key at https://financialmodelingprep.com/developer/docs/pricing
# FMP_API_KEY=

# Optional: enable normalized finance_data macro/rates lookups through FRED
# FRED_API_KEY=

# Optional: SEC requires a descriptive user agent for public company-facts calls
# SEC_API_USER_AGENT=Chloei finance research your-email@example.com

# Yahoo Finance (no API key) powers finance_data quotes, historical prices,
# analyst targets, options chains, and non-US fundamentals as a breadth/fallback
# provider. Enabled by default; set to false to disable it (e.g. stricter
# terms-of-service posture) — quotes/prices then fall back to Stooq.
# AGENT_FINANCE_YAHOO_ENABLED=true

# Optional: enable Mem0 long-term memory.
# Local/OSS: run Mem0 as a separate REST/dashboard service, keep auth enabled,
# and use a long deployment-specific ADMIN_API_KEY/service key for MEM0_API_KEY.
# Platform: use MEM0_API_URL=https://api.mem0.ai and a Platform API key.
# Use distinct MEMORY_AGENT_ID values per environment, for example
# chloei-local, chloei-development, chloei-preview, and chloei-production.
# Configure Mem0's OpenAI-compatible provider through AI Gateway with:
# OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# OPENAI_API_KEY=$AI_GATEWAY_API_KEY
# Recommended embedding model: openai/text-embedding-3-small
# MEMORY_PROVIDER=mem0
# MEM0_API_URL=http://localhost:8888
# MEM0_API_KEY=
# MEMORY_AGENT_ID=chloei-local
# MEMORY_TOP_K=6
# MEMORY_THRESHOLD=0.1
# MEMORY_CONTEXT_MAX_CHARS=3000
# MEMORY_COMMIT_MAX_CHARS=12000

# Optional shared parent cookie domain for cross-subdomain Better Auth sessions.
# Example: BETTER_AUTH_COOKIE_DOMAIN=chloei.ai
# BETTER_AUTH_COOKIE_DOMAIN=
# Optional comma-separated list of additional trusted origins for Better Auth.
# Example: BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BETTER_AUTH_TRUSTED_ORIGINS=
# On Vercel:
# - Set BETTER_AUTH_URL only for production, for example https://chloei.ai
# - Omit BETTER_AUTH_URL in preview so Better Auth can use VERCEL_URL automatically
# - Set BETTER_AUTH_TRUSTED_ORIGINS to any additional custom origins such as https://www.chloei.ai
# - Set BETTER_AUTH_COOKIE_DOMAIN only in production when you need shared cookies on a parent domain

# Optional agent request limit overrides.
# Safe defaults are enabled in code even when these remain commented out.
# AGENT_MAX_MESSAGES=50
# AGENT_MAX_MESSAGE_CHARS=12000
# AGENT_MAX_TOTAL_CHARS=48000
# AGENT_TOOL_MAX_STEPS=12
# AGENT_RESEARCH_TOOL_MAX_STEPS=20
# AGENT_CODE_EXECUTION_BACKEND=restricted
# AGENT_CODE_EXECUTION_PYTHON_VENV_PATH=/path/to/venv

# Optional streaming timeout override in milliseconds
# AGENT_STREAM_TIMEOUT_MS=800000
# AI_GATEWAY_CLIENT_TIMEOUT_MS=3600000

# Optional eval artifact/results directory
# AGENT_EVAL_RESULTS_DIR=evals/finance/results

# Optional in-memory rate limit overrides.
# Rate limiting is enabled by default unless you explicitly disable it.
# AGENT_RATE_LIMIT_ENABLED=true
# AGENT_RATE_LIMIT_WINDOW_MS=60000
# AGENT_RATE_LIMIT_MAX_REQUESTS=60
# AGENT_MAX_CONCURRENT_REQUESTS_PER_CLIENT=4
# AGENT_RATE_LIMIT_STORE=auto

# Optional Next.js request body limits
# NEXT_SERVER_ACTIONS_BODY_SIZE_LIMIT=1mb
# NEXT_PROXY_CLIENT_MAX_BODY_SIZE=1mb

# Optional log format override.
# Set to `json` to force structured JSON logs in development; production already emits JSON.
# LOG_FORMAT=json

# Optional override for the Python 3 binary used by the sandboxed code-execution tool.
# Defaults to `python3` on PATH.
# PYTHON3_PATH=/usr/bin/python3

# Trading Desk (TradingAgents multi-agent backend).
# The Trading Desk page (/trading-desk) and its API routes proxy a separate
# Python FastAPI service that wraps the TauricResearch/TradingAgents framework.
# Run that service from `tradingagents-service/` (see its README), then point
# the app at it here. Defaults to http://localhost:8000 and an enabled feature.
# TRADINGAGENTS_SERVICE_URL=http://localhost:8000
# Shared secret; must match TRADINGAGENTS_SERVICE_TOKEN in the service so only
# this app can call it. Leave blank in local dev.
# TRADINGAGENTS_SERVICE_TOKEN=
# Set to `false` to hide/disable the Trading Desk feature.
# TRADINGAGENTS_ENABLED=true
# Upstream request timeout in ms (a deep run can take a few minutes).
# TRADINGAGENTS_REQUEST_TIMEOUT_MS=600000

# Notes
# - Cursor Cloud setup writes local auth/database defaults and configured Cloud Agent secrets into `.env.local`.
# - Leave optional values commented out to use the safe defaults from code.
# - Thread storage now requires `pnpm migrate` before serving traffic.
# - Runtime config lives in `src/lib/server/agent-runtime-config.ts`.
# - FMP MCP integration lives in `src/lib/server/llm/ai-sdk-fmp-mcp-tools.ts`.
# - Prompt-context composition lives in `src/lib/server/agent-context.ts`.
# - `vercel env pull .env.local` is the quickest way to hydrate local development from Vercel.
# - Next.js body-size parsing lives in `next.config.mjs`.
# - Better Auth uses `BETTER_AUTH_URL` as the canonical app origin when set and otherwise falls back to Vercel system URLs.
# - `BETTER_AUTH_TRUSTED_ORIGINS` lets you allow additional origins such as `www`.
# - `AUTH_DATABASE_URL` lets you share Better Auth users/sessions across apps without moving app data.
# - `BETTER_AUTH_COOKIE_DOMAIN` enables shared auth cookies across trusted subdomains.
