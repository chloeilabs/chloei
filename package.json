{
  "name": "chloei",
  "version": "0.1.2",
  "description": "Chloei desktop and web chat application.",
  "productName": "Chloei",
  "main": "electron/main.cjs",
  "author": "Chloei Labs",
  "private": true,
  "scripts": {
    "auth:migrate": "better-auth migrate -y --config auth.ts",
    "app:migrate": "node app-migrate.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:standalone": "CHLOEI_DESKTOP_BUILD=1 next build",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "bundle:report": "node scripts/report-bundle-headroom.mjs",
    "desktop:build": "pnpm desktop:icons && pnpm build:standalone && node scripts/prepare-desktop-bundle.mjs",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:dist": "pnpm desktop:dist:mac",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs",
    "desktop:dist:mac": "pnpm desktop:build && electron-builder --config electron-builder.config.js --mac",
    "desktop:pack": "pnpm desktop:build && electron-builder --config electron-builder.config.js --dir",
    "desktop:smoke": "node scripts/check-desktop-shell.mjs",
    "migrate": "pnpm auth:migrate && pnpm app:migrate",
    "start": "node scripts/start-standalone-server.mjs",
    "threads:migrate": "pnpm app:migrate",
    "eval:finance": "node evals/finance/run-finance-evals.mjs",
    "eval:finance:live": "node evals/finance/run-finance-evals.mjs --mode live --input evals/finance/tasks/live-public-markets.jsonl",
    "eval:finance:grade": "node evals/finance/grade-finance-evals.mjs",
    "eval:finance:braintrust": "node evals/finance/publish-braintrust-eval.mjs",
    "mem0:cleanup-smoke": "node scripts/cleanup-memory-smoke.mjs",
    "mem0:smoke": "node scripts/mem0-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "playwright test",
    "test:smoke:memory": "playwright test tests/smoke/memory-authenticated-chat.spec.mjs",
    "test:smoke:mock": "E2E_MOCK_AUTH=1 E2E_MOCK_AUTH_ALLOW_NEXT_START=1 E2E_MOCK_AGENT_RESPONSE=SMOKE_OK SMOKE_EXPECTED_TEXT=SMOKE_OK SMOKE_PORT=3101 playwright test tests/smoke/mock-authenticated-chat.spec.mjs",
    "lint": "eslint src tests electron auth.ts app-migrate.mjs electron-builder.config.js eslint.config.mjs next.config.mjs playwright.config.mjs postcss.config.mjs scripts/check-desktop-shell.mjs scripts/generate-desktop-icons.mjs scripts/prepare-desktop-bundle.mjs scripts/start-standalone-server.mjs scripts/vercel-ignore-build.mjs --max-warnings=0",
    "lint:fix": "eslint src tests electron auth.ts app-migrate.mjs electron-builder.config.js eslint.config.mjs next.config.mjs playwright.config.mjs postcss.config.mjs scripts/check-desktop-shell.mjs scripts/generate-desktop-icons.mjs scripts/prepare-desktop-bundle.mjs scripts/start-standalone-server.mjs scripts/vercel-ignore-build.mjs --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.112",
    "@ai-sdk/mcp": "^1.0.41",
    "@base-ui/react": "^1.4.1",
    "@browserbasehq/sdk": "^2.10.0",
    "@napi-rs/canvas": "0.1.80",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^10.52.0",
    "@tanstack/react-query": "^5.100.9",
    "@tavily/core": "^0.7.3",
    "@upstash/search": "^0.1.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/otel": "^2.1.2",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.177",
    "better-auth": "^1.6.10",
    "braintrust": "^3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "inngest": "^4.3.0",
    "kysely": "^0.28.17",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "playwright-core": "^1.59.1",
    "posthog-js": "^1.372.10",
    "posthog-node": "^5.33.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.7.0",
    "shiki": "^4.0.2",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.2.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "axios": "^1.15.0",
      "ajv@>=6.0.0 <6.14.0": "^6.15.0",
      "better-call": "^1.3.5",
      "brace-expansion@>=1.0.0 <1.1.14": "^1.1.14",
      "brace-expansion@>=4.0.0 <5.0.5": "^5.0.5",
      "defu": "^6.1.7",
      "drizzle-orm": "^0.45.2",
      "flatted@<3.4.2": "^3.4.2",
      "follow-redirects@<1.16.0": "^1.16.0",
      "hono@<4.12.16": "^4.12.18",
      "ip-address@<=10.1.0": "^10.2.0",
      "@hono/node-server@<1.19.13": "^1.19.13",
      "lodash@<4.18.1": "^4.18.1",
      "minimatch@>=3.0.0 <3.1.5": "^3.1.5",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.10": "^8.5.10"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  }
}
