{
  "name": "chloei",
  "version": "0.1.5",
  "description": "Chloei web chat application.",
  "keywords": [
    "nextjs",
    "react",
    "ai",
    "chat",
    "vercel-ai-gateway",
    "better-auth"
  ],
  "homepage": "https://chloei.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chloeilabs/chloei.git"
  },
  "license": "UNLICENSED",
  "author": "Chloei Labs",
  "private": true,
  "scripts": {
    "auth:migrate": "better-auth migrate -y --config auth.ts",
    "app:migrate": "node app-migrate.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "bundle:report": "node scripts/report-bundle-headroom.mjs",
    "migrate": "pnpm auth:migrate && pnpm app:migrate",
    "start": "next start",
    "threads:migrate": "pnpm app:migrate",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "playwright test",
    "test:smoke:mock": "E2E_MOCK_AUTH=1 E2E_MOCK_AUTH_ALLOW_NEXT_START=1 E2E_MOCK_AGENT_RESPONSE=SMOKE_OK SMOKE_EXPECTED_TEXT=SMOKE_OK SMOKE_PORT=3101 playwright test tests/smoke/mock-authenticated-chat.spec.mjs",
    "test:smoke:mock:build": "pnpm build && pnpm test:smoke:mock",
    "lint": "eslint src tests auth.ts app-migrate.mjs eslint.config.mjs next.config.mjs playwright.config.mjs postcss.config.mjs scripts/vercel-ignore-build.mjs --max-warnings=0",
    "lint:fix": "eslint src tests auth.ts app-migrate.mjs eslint.config.mjs next.config.mjs playwright.config.mjs postcss.config.mjs scripts/vercel-ignore-build.mjs --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@openai/agents": "^0.12.0",
    "@openai/agents-openai": "^0.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exa-js": "^2.16.0",
    "kysely": "^0.29.2",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "next": "16.2.10",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.6.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "axios": "^1.15.0",
      "ajv@>=6.0.0 <6.14.0": "^6.15.0",
      "better-call": "^1.3.5",
      "brace-expansion@>=1.0.0 <1.1.14": "^1.1.14",
      "brace-expansion@>=4.0.0 <5.0.5": "^5.0.5",
      "defu": "^6.1.7",
      "drizzle-orm": "^0.45.2",
      "flatted@<3.4.2": "^3.4.2",
      "follow-redirects@<1.16.0": "^1.16.0",
      "ip-address@<=10.1.0": "^10.2.0",
      "lodash@<4.18.1": "^4.18.1",
      "minimatch@>=3.0.0 <3.1.5": "^3.1.5",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.10": "^8.5.10"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  }
}
